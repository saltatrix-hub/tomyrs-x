<Application x:Class="Flyworm.Setup.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="BgBrush" Color="#0B0714"/>
        <SolidColorBrush x:Key="CardBrush" Color="#1B132C"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#8B5CF6"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F5F3FF"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#A89BB8"/>
    </Application.Resources>
</Application>
