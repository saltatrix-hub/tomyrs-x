<Window x:Class="TomyrsX.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tomyrs X Kurulum"
        Height="420" Width="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI">
    <Grid Margin="28">
        <StackPanel VerticalAlignment="Center">
            <Image x:Name="LogoImage" Width="64" Height="64" HorizontalAlignment="Left" Stretch="Uniform"/>
            <TextBlock Text="Tomyrs X" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,14,0,0"/>
            <TextBlock Text="Bilgisayar hızlandırma kurulumu" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,18"/>
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" Margin="0,0,0,18"
                       Text="Kurulum, programı yükler ve masaüstüne Tomyrs X kısayolunu ekler. Sonra o simgeden çalıştır."/>
            <ProgressBar x:Name="Bar" Height="10" Minimum="0" Maximum="100" Value="0" Margin="0,0,0,10"/>
            <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedBrush}" Text="Kuruluma hazır." Margin="0,0,0,18"/>
            <Button x:Name="InstallButton" Content="Kur" Click="Install_Click" Cursor="Hand"
                    HorizontalAlignment="Left" Padding="28,10" FontWeight="SemiBold" Foreground="White" BorderThickness="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{StaticResource AccentBrush}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#06B6D4"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</Window>
