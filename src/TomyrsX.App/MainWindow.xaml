<Window x:Class="TomyrsX.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tomyrs X"
        Height="780" Width="1180"
        MinHeight="640" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Loaded="Window_Loaded">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="22,22,22,10">
                    <Image x:Name="LogoImage" Width="64" Height="64" HorizontalAlignment="Left" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock x:Name="TitleText" Text="Tomyrs X" FontSize="22" FontWeight="Bold" Margin="0,14,0,2" Foreground="#ECFBFF"/>
                    <TextBlock x:Name="SubtitleText" Text="Bilgisayar hızlandırma" Foreground="#ECFBFF"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="16,0,16,18">
                    <StackPanel Orientation="Horizontal" Margin="6,0,0,10">
                        <Button x:Name="LangTr" Content="TR" Style="{StaticResource GhostButton}" Click="LangTr_Click" Padding="10,6"/>
                        <Button x:Name="LangEn" Content="EN" Style="{StaticResource GhostButton}" Click="LangEn_Click" Margin="8,0,0,0" Padding="10,6"/>
                    </StackPanel>
                    <TextBlock x:Name="AdminText" Foreground="{StaticResource AccentSoftBrush}" FontSize="11" Margin="6,0,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Margin="6,16,6,0">
                    <RadioButton x:Name="NavDebloat" Style="{StaticResource NavButton}" IsChecked="True" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavTweaks" Style="{StaticResource NavButton}" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavGpu" Style="{StaticResource NavButton}" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavLog" Style="{StaticResource NavButton}" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavAbout" Style="{StaticResource NavButton}" Checked="Nav_Checked"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="22,18,22,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="PageHint" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12"/>
                <ScrollViewer x:Name="PageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="PageHost"/>
                </ScrollViewer>
                <Grid x:Name="LogPanel" Grid.Row="1" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="420">
                        <TextBlock x:Name="LogStatus" Text="Henüz bir işlem yok." FontSize="22" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" TextAlignment="Center"/>
                        <TextBlock x:Name="LogPercent" Text="" FontSize="46" FontWeight="Bold"
                                   Foreground="{StaticResource AccentSoftBrush}" HorizontalAlignment="Center" Margin="0,10,0,18"/>
                        <ProgressBar x:Name="LogProgress" Minimum="0" Maximum="100" Value="0"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="18,14">
                <DockPanel>
                    <StackPanel x:Name="ActionButtons" DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="DefaultsButton" Style="{StaticResource GhostButton}" Click="Defaults_Click" Margin="0,0,8,0"/>
                        <Button x:Name="SelectAllButton" Style="{StaticResource GhostButton}" Click="SelectAll_Click" Margin="0,0,8,0"/>
                        <Button x:Name="ClearButton" Style="{StaticResource GhostButton}" Click="Clear_Click" Margin="0,0,8,0"/>
                        <Button x:Name="ApplyButton" Style="{StaticResource PrimaryButton}" Click="Apply_Click"/>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <CheckBox x:Name="RestorePointBox" IsChecked="True"/>
                        <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedBrush}" Margin="0,8,16,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
